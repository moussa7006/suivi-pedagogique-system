<mxfile host="app.diagrams.net" modified="2026-08-22T10:00:00.000Z" agent="zed" version="24.0.0" type="device">
  <diagram id="emargement-sequence" name="Diagramme séquence - Émargement">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="Diagramme de séquence – Processus d'émargement par QR code" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->
        <!-- Admin -->
        <mxCell id="act_admin" value="Administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="line_admin" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="55" y="120" as="sourcePoint" />
            <mxPoint x="55" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Enseignant -->
        <mxCell id="box_ens" value="Enseignant (Mobile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#1e1b4b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="85" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_ens" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335" y="135" as="sourcePoint" />
            <mxPoint x="335" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Backend API -->
        <mxCell id="box_api" value="API REST&#xa;Spring Boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="85" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_api" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="575" y="135" as="sourcePoint" />
            <mxPoint x="575" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Service / QRCode -->
        <mxCell id="box_svc" value="Service Émargement&#xa;+ QR Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#3b0764;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="85" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_svc" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="825" y="135" as="sourcePoint" />
            <mxPoint x="825" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Base de données -->
        <mxCell id="box_db" value="Base de données" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#fff7ed;strokeColor=#f59e0b;fontColor=#7c2d12;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="85" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#94a3b8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="135" as="sourcePoint" />
            <mxPoint x="1050" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== PHASE 1 : Génération du QR ==================== -->
        <mxCell id="phase1" value="Phase 1 — Génération du QR code (Administrateur)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="m1a" value="POST /api/qr-codes {séanceId}" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontColor=#1e293b;" edge="1" parent="1" source="act_admin" target="box_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1b" value="Créer le QR code avec date d'expiration" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_api" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1c" value="INSERT QRCode" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontStyle=2;" edge="1" parent="1" source="box_svc" target="box_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1d" value="QR code généré (affiché à l'écran de la salle)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=12;strokeColor=#64748b;" edge="1" parent="1" source="box_svc" target="act_admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PHASE 2 : Sélection de la séance ==================== -->
        <mxCell id="phase2" value="Phase 2 — L'enseignant sélectionne sa séance du jour" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="m2a" value="GET /api/seances/du-jour" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_ens" target="box_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2b" value="Lister les séances d'aujourd'hui (statut)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_api" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2c" value="SELECT séances" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontStyle=2;" edge="1" parent="1" source="box_svc" target="box_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2d" value="Liste des séances du jour" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=12;strokeColor=#64748b;" edge="1" parent="1" source="box_api" target="box_ens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2e" value="Sélectionne la séance à émarger" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=12;fontStyle=3;strokeColor=#64748b;" edge="1" parent="1" source="box_ens" target="box_ens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PHASE 3 : Scan QR + validations ==================== -->
        <mxCell id="phase3" value="Phase 3 — Scan du QR code et validations" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="m3a" value="POST /api/emargements/scan&#xa;{seanceId, tokenQRCode, lat, lon}" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_ens" target="box_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3b" value="faireEmargement(request)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_api" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validations dans le service -->
        <mxCell id="v1" value="alt&#xa;Vérif. QR : valide &amp; non expiré" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="560" width="420" height="180" as="geometry" />
        </mxCell>

        <mxCell id="v1a" value="Vérifier QR code valide" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_svc" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1b" value="Vérifier enseignant assigné" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_svc" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1c" value="Vérifier séance aujourd'hui + horaire" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_svc" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1d" value="Vérifier géolocalisation (distance ≤ max)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_svc" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1e" value="Erreur si QR invalide/expiré, mauvaise personne, hors horaire ou trop loin" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;fontColor=#b91c1c;strokeColor=#ef4444;" edge="1" parent="1" source="box_svc" target="box_ens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PHASE 4 : Enregistrement ==================== -->
        <mxCell id="m4a" value="Créer / mettre à jour l'émargement (statut VALIDE)&#xa;lier à la séance" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_svc" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4b" value="INSERT / UPDATE Emargement + Seance" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontStyle=2;" edge="1" parent="1" source="box_svc" target="box_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4c" value="Emargement enregistré" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=12;strokeColor=#64748b;" edge="1" parent="1" source="box_db" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4d" value="200 OK : « Scan validé. Veuillez remplir la fiche de progression pour finaliser l'émargement. »" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontColor=#065f46;strokeColor=#10b981;" edge="1" parent="1" source="box_api" target="box_ens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== PHASE 5 : Fiche de progression ==================== -->
        <mxCell id="phase5" value="Phase 5 — Finalisation par la fiche de progression" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="m5a" value="POST /api/fiches-progression (remplit la fiche)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_ens" target="box_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5b" value="Enregistrer la fiche de progression" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="box_api" target="box_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5c" value="INSERT FicheProgression" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;fontStyle=2;" edge="1" parent="1" source="box_svc" target="box_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5d" value="200 OK : Émargement finalisé" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=12;fontColor=#065f46;strokeColor=#10b981;" edge="1" parent="1" source="box_api" target="box_ens">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
